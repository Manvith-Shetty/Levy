# Copy to .env and adjust: cp .env.example .env
# Every value below is optional — the defaults point at the live Leash
# deployment (ENSv2 tree on Sepolia, HCS topic on Hedera testnet), so the
# dashboard runs live with no .env at all. To point it at a redeploy, set the
# values here and rebuild (npm run build): VITE_-prefixed values are baked
# into the browser bundle at build time. Nothing deployment-specific is
# hardcoded in src/ — it all comes from src/lib/config.ts, which reads these.

# ─── Which data the dashboard opens with ──────────────────────────────────────
# live — reads the chain + Hedera (default). demo — generated data. The topbar's
# Demo Mode toggle switches between them at runtime either way.
# VITE_DEFAULT_MODE=live

# ─── ENSv2 mandate tree ───────────────────────────────────────────────────────
# Chain the tree lives on. 11155111 (Sepolia) and 1 (mainnet) use viem's
# built-in definitions; any other id is built from the values below.
# VITE_ENS_CHAIN_ID=11155111
# Its name wherever the interface mentions it.
# VITE_ENS_CHAIN_NAME=Sepolia
# Block explorer for tree transactions and addresses.
# VITE_ETH_EXPLORER_URL=https://sepolia.etherscan.io
# Multicall3 on that chain (the same address on most chains).
# VITE_MULTICALL3_ADDRESS=0xca11bde05977b3631167028862be2a173976ca11
# Any JSON-RPC for that chain that allows browser (CORS) requests.
# VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Tried in order when the RPC above returns no tree events (some public nodes
# answer eth_getLogs with nothing). Comma-separated.
# VITE_SEPOLIA_RPC_FALLBACKS=https://sepolia.gateway.tenderly.co,https://ethereum-sepolia-rpc.publicnode.com
# Blocks per eth_getLogs call. Lower it for RPCs with a smaller range cap.
# VITE_ENS_LOG_WINDOW=45000
# Registry holding the top of the tree (`root`). Deeper levels are found by
# following on-chain subregistry pointers, exactly as the gateway does.
# VITE_ENS_TOP_REGISTRY=0x51d32dfa5baf7e3e1d718fdd37d0c346c5ba7838
# VITE_ENS_REGISTRAR=0x33699c74f777c581db3b9c7079d87b778cae2312
# First block to scan for tree events — the deploy block.
# VITE_ENS_FROM_BLOCK=11684263
# Account that owns the tree's resolvers. Used by scripts/set-record.mjs
# (which reads this file too) to simulate a record change before sending it.
# VITE_DEPLOYER_ADDRESS=0x06de353ddb9c102cda81edc8a535b88dfd1f7c08

# ─── Hedera ───────────────────────────────────────────────────────────────────
# VITE_HEDERA_NETWORK=testnet
# Its name in the interface (defaults from the network: Hedera Testnet/Mainnet).
# VITE_HEDERA_NETWORK_NAME=Hedera Testnet
# VITE_HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
# Explorer for transactions, topics and accounts (HashScan's URL shape).
# VITE_HASHSCAN_URL=https://hashscan.io
# HCS topic the gateway publishes receipts and refusals to. When unset, the
# topic the gateway advertises in its manifest is used.
# VITE_HCS_TOPIC_ID=0.0.10494264
# The one Hedera account every demo agent pays from.
# VITE_HEDERA_PAYER_ACCOUNT=0.0.10499031
# Asset the tree's budgets are denominated in (on-chain they're raw integers).
# VITE_ASSET_SYMBOL=USDC
# VITE_ASSET_DECIMALS=6
# VITE_ASSET_TOKEN_ID=0.0.429274

# ─── Agents and services ──────────────────────────────────────────────────────
# Agent a new paid run or policy simulation starts with, when it exists.
# VITE_DEFAULT_AGENT=sub.agent.root
# Service categories an agent can be allowed (Create agent, simulator), in the
# order the Services page lists them. Comma-separated.
# VITE_SERVICES=inference,compute,ops,data
# First task suggested per service in "Run a paid request".
# VITE_DEFAULT_TASK_INFERENCE=Explain Hedera's hashgraph consensus in three sentences.
# VITE_DEFAULT_TASK_COMPUTE=Run a Redis cache for 10 minutes.

# ─── Autopilot ────────────────────────────────────────────────────────────────
# Public link to the stack the agents keep alive. Defaults to the origin of the
# ops provider's end-to-end check (http://localhost:8088 for demo/shop).
# VITE_SHOP_URL=https://shop.example.com
# What each service of the stack is, for people: name=label, comma-separated.
# VITE_STACK_SERVICE_LABELS=cache=Redis cache,api=Python API,web=Web front end
# Atomic units a diagnosis is expected to cost, for the policy check on the
# diagnosing agent's card (1000 = $0.001 in USDC).
# VITE_AUTOPILOT_DIAGNOSIS_ESTIMATE=1000

# ─── Refresh intervals (milliseconds) ─────────────────────────────────────────
# Live data (tree, HCS, balances).
# VITE_POLL_MS=15000
# Autopilot page.
# VITE_AUTOPILOT_POLL_MS=1500
# Running containers on Services.
# VITE_RESOURCES_POLL_MS=5000

# ─── Gateway ──────────────────────────────────────────────────────────────────
# The dashboard also reads the gateway's manifest and in-memory receipts and
# refusals. Optional: HCS already carries both. Set to false to skip it.
# VITE_GATEWAY_ENABLED=true
#
# Dev: the Vite dev server proxies same-origin /api/* to this address. Server
# side only — no VITE_ prefix, never reaches the browser.
GATEWAY_PROXY_TARGET=http://localhost:4021
#
# Production: leave VITE_GATEWAY_URL unset and have whatever serves dist/
# proxy /api/* to the gateway (see README "Deploying"). Only set it to an
# absolute URL once the gateway sends CORS headers for this origin — the
# browser then calls the gateway directly.
# VITE_GATEWAY_URL=https://gateway.example.com

# ─── Agent runner (real paid requests from the dashboard) ─────────────────────
# Dev only, never reaches the browser: where the dev server forwards /runner.
RUNNER_PROXY_TARGET=http://localhost:4030
# VITE_RUNNER_ENABLED=true
# Full URL only for a runner that sends CORS headers for this origin:
# VITE_RUNNER_URL=https://runner.example.com
# Must match the runner's RUNNER_TOKEN, if it was started with one:
# VITE_RUNNER_TOKEN=
