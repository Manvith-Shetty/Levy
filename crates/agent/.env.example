# ─── Buyer agent ────────────────────────────────────────────────────────────
# ECDSA account with testnet HBAR. Required.
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PRIVATE_KEY=0x...

# ENS subname this agent spends against — must resolve under the gateway's
# mandate tree. With MANDATE_MODE=ens that's the live Sepolia tree:
# root, agent.root or sub.agent.root. (With MANDATE_MODE=mock, seed one via
# POST /v1/mandate/seed first.) Required.
#
# All demo agents share this one Hedera payer account; the ENS name is what
# the guard checks and what receipts attribute spend to.
AGENT_ENS_NAME=sub.agent.root

PROVIDERS=http://localhost:4021
PROMPT=Explain Hedera's hashgraph consensus in three sentences.
MAX_OUTPUT_TOKENS=128
# Most this agent will pay for one request, in atomic units of the
# provider's asset. USDC (6 decimals): 5000 = $0.005.
BUDGET_ATOMIC=5000
