# ─── Buyer agent ────────────────────────────────────────────────────────────
# ECDSA account with testnet HBAR. Required.
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PRIVATE_KEY=0x...

# ENS subname this agent spends against — must resolve under the gateway's
# mandate tree. With MANDATE_MODE=ens that's the live Sepolia tree:
# root, agent.root or sub.agent.root. (With MANDATE_MODE=mock, seed one via
# POST /v1/mandate/seed first.) Required.
#
# All demo agents share this one Hedera payer account; the ENS name is what
# the guard checks and what receipts attribute spend to.
AGENT_ENS_NAME=sub.agent.root

PROVIDERS=http://localhost:4021,http://localhost:4022,http://localhost:4023   # A, B, C (scripts/demo-providers.sh starts B and C)
PROMPT=Explain Hedera's hashgraph consensus in three sentences.
MAX_OUTPUT_TOKENS=128
# Most this agent will pay for one request, in atomic units of the
# provider's asset. USDC (6 decimals): 5000 = $0.005.
BUDGET_ATOMIC=5000

# --- agent-runner (cargo run -p agent --bin agent-runner) --------------------
# Same wallet and PROVIDERS as above. The dashboard reaches it through /runner.
# RUNNER_PORT=4030
# Hard ceiling on any single run, in atomic units (10000 = $0.01 USDC).
# RUNNER_MAX_ATOMIC=10000
# When set, callers must send "Authorization: Bearer <token>" (the dashboard
# sends VITE_RUNNER_TOKEN). Set it whenever the runner is reachable publicly.
# RUNNER_TOKEN=
# Registry topic the runner discovers providers on and confirms receipts against.
# Defaults to whatever topic the configured providers publish to.
# HCS_TOPIC_ID=0.0.10494264
# MIRROR_URL=https://testnet.mirrornode.hedera.com
# Plans compute tasks ("Run a Redis cache for 10 minutes") into jobs with a
# model on Hugging Face. Without it, simple keyword rules plan them.
# HF_TOKEN=hf_...
# Preference list; "auto" lets any live model in the router's catalog stand in.
# PLANNER_MODEL=meta-llama/Llama-3.1-8B-Instruct,auto

# --- Autopilot (Dashboard → Autopilot) -----------------------------------------
# Three agents keep an ops provider's stack alive: one watches (free), one buys
# a diagnosis (needs inference), one buys repairs (needs ops).
# AUTOPILOT=1                           # start switched on (default off)
# AUTOPILOT_DETECT_AGENT=watcher
# AUTOPILOT_DIAGNOSE_AGENT=sub.agent.root
# AUTOPILOT_FIX_AGENT=agent.root
# OPS_PROVIDER=http://localhost:4025    # default: the first ops provider discovered
