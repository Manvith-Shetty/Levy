# ─── Server ────────────────────────────────────────────────────────────────
PROVIDER_NAME=leash-provider-a
PORT=4021
BASE_URL=http://localhost:4021

# ─── Payments ──────────────────────────────────────────────────────────────
HEDERA_NETWORK=testnet
PAYMENT_ASSET=hbar
PAYMENT_ACCOUNT_ID=0.0.xxxxxxxx
FACILITATOR_URL=https://api.testnet.blocky402.com

# Prices in the asset's smallest unit
INPUT_PRICE_PER_1K=100000       # 0.001 HBAR / 1K input tokens
OUTPUT_PRICE_PER_1K=400000       # 0.004 HBAR / 1K output tokens
MIN_PAYMENT=10000                # Minimum charge = 0.0001 HBAR
QUOTE_TTL_SECS=180               # Quote validity duration = 3 minutes

# ─── Mandate guard ──────────────────────────────────────────────────────────
# mock (default) — in-memory tree, driven live via POST /v1/mandate/seed and
#                  /v1/mandate/revoke; no deployed ENSv2 registry needed.
# ens            — reads the real PermissionedRegistry on Sepolia; see
#                  ../mandate/.env.example for SEPOLIA_RPC_URL and
#                  MANDATE_REGISTRY_ADDRESS.
# off            — disables the guard entirely.
MANDATE_MODE=mock

# ─── Hedera Receipts ───────────────────────────────────────────────────────
# Run `cargo run -p gateway --bin create-topic` once, then paste the id here.
HEDERA_OPERATOR_ID=0.0.xxxxxxxx
HEDERA_OPERATOR_KEY=
HCS_TOPIC_ID=0.0.xxxxxxx

# ─── Real inference (optional) ─────────────────────────────────────────────
# Point at any OpenAI-compatible server; without it a deterministic stub runs.
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=qwen2.5-7b-instruct
# OPENAI_API_KEY=

# ─── Allowance drip (Scheduled Transactions) ───────────────────────────────
# Uses HEDERA_NETWORK / HEDERA_OPERATOR_ID / HEDERA_OPERATOR_KEY above.
# AGENT_ACCOUNT_ID=0.0.xxxxxxx
# DRIP_AMOUNT_TINYBAR=10000000                # 0.1 HBAR per drip
# DRIP_INTERVAL_SECS=300

# ─── ENS mandate tree deploy (Vishruth / Leash) ────────────────────────────
# Fill these, then run contracts/DEPLOY.md. Never commit real values.
# SEPOLIA_RPC_URL=https://sepolia.example.com
# DEPLOYER_KEY=0x...                          # funded Sepolia key (testnet only)
# After DeployMandate.s.sol lands, paste its logged addresses here:
# LEASH_L1_REGISTRY=0x...
# LEASH_L2_REGISTRY=0x...
# LEASH_L3_REGISTRY=0x...
# LEASH_REGISTRAR=0x...
# Then the gateway reads the live tree with (TOP registry L1 — the
# reader walks down getSubregistry pointers from here):
# MANDATE_MODE=ens
# MANDATE_REGISTRY_ADDRESS=${LEASH_L1_REGISTRY}
