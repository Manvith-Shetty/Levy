# ─── Gateway server (x402-gated, mandate-checked, metered inference) ──────
# Hedera account credited by every payment. Required.
HEDERA_PAY_TO_ACCOUNT_ID=0.0.xxxxxxx

PROVIDER_NAME=leash-provider-a
PORT=4021
BASE_URL=http://localhost:4021
HEDERA_NETWORK=testnet                       # testnet | mainnet
ASSET=hbar                                   # hbar | usdc
FACILITATOR_URL=https://api.testnet.blocky402.com

# Per-token price schedule, in atomic units of ASSET.
# HBAR has 8 decimals, so 100000 = 0.001 HBAR.
PRICE_PER_1K_INPUT=100000
PRICE_PER_1K_OUTPUT=400000
PRICE_MINIMUM=10000
QUOTE_TTL_SECS=180

# ─── Mandate guard ──────────────────────────────────────────────────────────
# mock (default) — in-memory tree, driven live via POST /v1/mandate/seed and
#                  /v1/mandate/revoke; no deployed ENSv2 registry needed.
# ens            — reads the real PermissionedRegistry on Sepolia; see
#                  ../mandate/.env.example for SEPOLIA_RPC_URL and
#                  MANDATE_REGISTRY_ADDRESS.
# off            — disables the guard entirely.
MANDATE_MODE=mock

# ─── HCS settlement receipts (optional but recommended) ────────────────────
# Run `cargo run -p gateway --bin create-topic` once, then paste the id here.
# Also used by the allowance-drip binary below.
# HEDERA_OPERATOR_ID=0.0.xxxxxxx
# HEDERA_OPERATOR_KEY=0x...
# HCS_TOPIC_ID=0.0.xxxxxxx

# ─── Real inference (optional) ─────────────────────────────────────────────
# Point at any OpenAI-compatible server; without it a deterministic stub runs.
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=qwen2.5-7b-instruct
# OPENAI_API_KEY=

# ─── Allowance drip (Scheduled Transactions) ───────────────────────────────
# Uses HEDERA_NETWORK / HEDERA_OPERATOR_ID / HEDERA_OPERATOR_KEY above.
# DRIP_AGENT_ACCOUNT_ID=0.0.xxxxxxx
# DRIP_AMOUNT_TINYBAR=10000000                # 0.1 HBAR per drip
# DRIP_INTERVAL_SECS=300
