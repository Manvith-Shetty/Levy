# ─── Server ────────────────────────────────────────────────────────────────
PROVIDER_NAME=leash-provider-a
PORT=4021
BASE_URL=http://localhost:4021

# ─── Payments ──────────────────────────────────────────────────────────────
HEDERA_NETWORK=testnet

# usdc — testnet USDC (0.0.429274, 6 decimals). Both PAYMENT_ACCOUNT_ID and
#        the agent's payer account must be associated with the token first,
#        and the payer needs a USDC balance (Circle testnet faucet).
# hbar — native HBAR (8 decimals).
PAYMENT_ASSET=usdc
PAYMENT_ACCOUNT_ID=0.0.xxxxxxxx
FACILITATOR_URL=https://api.testnet.blocky402.com

# Prices in the asset's smallest unit. Leave unset for the defaults, which
# carry the same human prices for either asset: 0.001 per 1K input tokens,
# 0.004 per 1K output, 0.0001 minimum (USDC: 1000 / 4000 / 100; HBAR:
# 100000 / 400000 / 10000). The live ENS tree's budgets are read in the
# same units — with USDC, root/agent/sub = $0.10 / $0.05 / $0.01 and sub's
# maxPerCall = $0.005, so a default 128-token request (~$0.0005) clears it.
# INPUT_PRICE_PER_1K=1000
# OUTPUT_PRICE_PER_1K=4000
# MIN_PAYMENT=100
QUOTE_TTL_SECS=180               # Quote validity duration = 3 minutes

# ─── Mandate guard ──────────────────────────────────────────────────────────
# mock (default) — in-memory tree, driven live via POST /v1/mandate/seed and
#                  /v1/mandate/revoke; no deployed ENSv2 registry needed.
# ens            — reads the live ENSv2 tree on Sepolia (see the addresses
#                  at the bottom of this file).
# off            — disables the guard entirely.
MANDATE_MODE=ens
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Top registry (L1, holds `root`) — the reader walks down from here.
MANDATE_REGISTRY_ADDRESS=0x51d32dfa5baf7e3e1d718fdd37d0c346c5ba7838

# ─── Hedera Receipts ───────────────────────────────────────────────────────
# Run `cargo run -p gateway --bin create-topic` once, then paste the id here.
# Settled payments AND mandate refusals are published to this topic (told
# apart by each message's `kind`), so the dashboard can replay both.
HEDERA_OPERATOR_ID=0.0.xxxxxxxx
HEDERA_OPERATOR_KEY=
HCS_TOPIC_ID=0.0.xxxxxxx

# ─── Real inference (optional) ─────────────────────────────────────────────
# Point at any OpenAI-compatible server; without it a deterministic stub runs.
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=qwen2.5-7b-instruct
# OPENAI_API_KEY=

# ─── Allowance drip (Scheduled Transactions) ───────────────────────────────
# Uses HEDERA_NETWORK / HEDERA_OPERATOR_ID / HEDERA_OPERATOR_KEY above.
# AGENT_ACCOUNT_ID=0.0.xxxxxxx
# DRIP_AMOUNT_TINYBAR=10000000                # 0.1 HBAR per drip
# DRIP_INTERVAL_SECS=300

# ─── ENS mandate tree (live on Sepolia, chain id 11155111) ──────────────────
# Deployed by contracts/script/DeployMandate.s.sol at block 11684263.
# LEASH_L1_REGISTRY=0x51d32dfa5baf7e3e1d718fdd37d0c346c5ba7838   # holds `root`
# LEASH_L2_REGISTRY=0xec8f768460dd212fc83d47b048045eb6b6b13097   # holds `agent`
# LEASH_L3_REGISTRY=0x1189d5a05e60f7144b40b5f0fa144d1e2b695cf8   # holds `sub`
# LEASH_REGISTRAR=0x33699c74f777c581db3b9c7079d87b778cae2312
# To redeploy: fill SEPOLIA_RPC_URL + DEPLOYER_KEY (testnet only, never
# commit) and follow contracts/DEPLOY.md.
# DEPLOYER_KEY=0x...
